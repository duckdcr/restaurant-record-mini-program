/* 01 待办 —— 还原原型 #view-tasks */
.view { padding: 42rpx 35rpx 100rpx; }

.eyeline {
  margin: 0 0 13rpx;
  color: var(--text-3, #68746c);
  font-family: var(--font-mono, monospace);
  font-size: 21rpx;
  font-weight: 500;
  letter-spacing: .08em;
}
.view-title { font-size: 54rpx; font-weight: 400; letter-spacing: -.04em; line-height: 1.2; color: var(--ink, #13251a); }
.view-sub { margin: 15rpx 0 0; color: var(--text-2, #526158); font-size: 25rpx; line-height: 1.6; }

/* 今日留样进度大卡 */
.summary {
  position: relative;
  overflow: hidden;
  margin-top: 38rpx;
  padding: 42rpx;
  border-radius: var(--radius-panel, 31rpx);
  background: var(--sage, #b1dbb8);
}
.summary::after {
  content: "48H";
  position: absolute;
  right: -15rpx;
  top: 8rpx;
  color: rgba(15, 62, 23, .08);
  font-family: var(--font-serif, Georgia, serif);
  font-size: 123rpx;
  font-weight: 400;
  letter-spacing: -.08em;
}
.summary-label { color: var(--forest, #0f3e17); font-size: 23rpx; font-weight: 500; }
.summary-h2 {
  position: relative;
  z-index: 1;
  margin: 17rpx 0 35rpx;
  max-width: 510rpx;
  font-size: 46rpx;
  line-height: 1.3;
  font-weight: 400;
  letter-spacing: -.035em;
  color: var(--ink, #13251a);
}
.summary-h2 b { font-weight: 650; }
.summary-stats { display: flex; gap: 35rpx; margin-bottom: 35rpx; position: relative; z-index: 1; }
.summary-stats view { min-width: 123rpx; }
.summary-stats strong { display: block; font-family: var(--font-serif, Georgia, serif); font-size: 48rpx; font-weight: 400; color: var(--forest, #0f3e17); }
.summary-stats span { display: block; margin-top: 10rpx; color: rgba(19, 37, 26, .68); font-size: 21rpx; }

/* 区块标题 */
.section-head { margin: 52rpx 4rpx 23rpx; display: flex; align-items: flex-end; justify-content: space-between; gap: 23rpx; }
.section-h2 { font-size: 31rpx; font-weight: 650; letter-spacing: -.02em; color: var(--ink, #13251a); }
.section-aside { color: var(--text-3, #68746c); font-size: 21rpx; }
.link-button {
  border: 0;
  background: transparent;
  padding: 13rpx 0;
  color: var(--forest, #0f3e17);
  font-size: 21rpx;
  line-height: 1.4;
  margin: 0;
}
.link-button::after { border: none; }

/* 任务列表 */
.task-list { border-top: 1rpx solid var(--line, #dfe6df); }
.task {
  width: 100%;
  border-bottom: 1rpx solid var(--line, #dfe6df);
  padding: 31rpx 4rpx;
  display: grid;
  grid-template-columns: 12rpx minmax(0, 1fr) auto;
  gap: 25rpx;
  align-items: center;
  box-sizing: border-box;
}
.task-hover { background: rgba(255, 254, 252, .7); }
.task-dot { width: 12rpx; height: 69rpx; border-radius: 999rpx; background: var(--success, #257a4a); }
.task.warning .task-dot { background: var(--warning, #9b5514); }
.task.danger .task-dot { background: var(--danger, #a93430); }
.task-copy { min-width: 0; }
.task-copy strong { display: block; font-size: 27rpx; font-weight: 650; color: var(--ink, #13251a); }
.task-copy span { display: block; margin-top: 8rpx; color: var(--text-2, #526158); font-size: 23rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.task-time {
  color: var(--text-3, #68746c);
  font-family: var(--font-mono, monospace);
  font-size: 21rpx;
  font-weight: 500;
}

/* 各餐完成度 */
.meal-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15rpx; }
.meal {
  padding: 27rpx 23rpx;
  border: 1rpx solid var(--line, #dfe6df);
  border-radius: var(--radius-control, 19rpx);
  background: var(--surface, #fffefc);
}
.meal strong { display: block; font-size: 25rpx; font-weight: 650; color: var(--ink, #13251a); }
.meal span { display: block; margin-top: 19rpx; color: var(--text-2, #526158); font-size: 23rpx; }
.progress { height: 8rpx; margin-top: 19rpx; overflow: hidden; background: #e8ece7; border-radius: 99rpx; }
.progress i { display: block; height: 100%; border-radius: inherit; background: var(--success, #257a4a); }
.meal.incomplete .progress i { background: var(--warning, #9b5514); }

/* 抽屉内表单（与原型 drawer 内 form-group 一致） */
.drawer-copy { margin: 13rpx 0 35rpx; color: var(--text-2, #526158); font-size: 23rpx; line-height: 1.6; }
.drawer-copy text { font-weight: 650; color: var(--ink, #13251a); }
.form-group { margin-bottom: 29rpx; }
.form-group label { display: block; margin-bottom: 13rpx; color: var(--text-2, #526158); font-size: 23rpx; }
.form-control {
  width: 100%;
  min-height: 85rpx;
  border: 1rpx solid var(--line, #dfe6df);
  border-radius: var(--radius-control, 19rpx);
  background: var(--surface, #fffefc);
  color: var(--ink, #13251a);
  padding: 19rpx 23rpx;
  font-size: 27rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}
.form-control.textarea { min-height: 154rpx; width: 100%; padding: 19rpx 23rpx; line-height: 1.55; }
