/* 04 管理 —— 还原原型 #view-admin（1px ≈ 1.9rpx） */
.view { padding: 42rpx 35rpx 100rpx; }

.eyeline {
  margin: 0 0 13rpx;
  color: var(--text-3, #68746c);
  font-family: var(--font-mono, monospace);
  font-size: 21rpx;
  font-weight: 500;
  letter-spacing: .08em;
}
.view-title { font-size: 54rpx; font-weight: 400; letter-spacing: -.04em; line-height: 1.2; color: var(--ink, #13251a); }
.view-sub { margin: 15rpx 0 0; color: var(--text-2, #526158); font-size: 25rpx; line-height: 1.6; display: block; }

/* 三段切换（原型 .admin-switch） */
.admin-switch {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-top: 34rpx;
  padding: 8rpx;
  border-radius: 23rpx;
  background: #e9ede8;
}
.admin-tab {
  min-height: 73rpx;
  border: 0;
  border-radius: 17rpx;
  background: transparent;
  color: var(--text-2, #526158);
  font-size: 23rpx;
  font-weight: 400;
  line-height: 73rpx;
  padding: 0;
}
.admin-tab::after { border: none; }
.admin-tab.active {
  background: var(--surface, #fffefc);
  color: var(--forest, #0f3e17);
  font-weight: 650;
}

/* 面板（原型 .admin-panel） */
.admin-panel {
  margin-top: 38rpx;
  animation: view-in 180ms cubic-bezier(.2, 0, 0, 1) both;
}
@keyframes view-in {
  from { opacity: 0; transform: translateY(15rpx); }
  to { opacity: 1; transform: none; }
}

.admin-intro {
  display: block;
  margin: 0 0 34rpx;
  color: var(--text-2, #526158);
  font-size: 23rpx;
  line-height: 1.65;
}

/* 表单（原型 .form-group / .form-control） */
.form-group { margin-bottom: 29rpx; }
.form-label {
  display: block;
  margin-bottom: 13rpx;
  color: var(--text-2, #526158);
  font-size: 23rpx;
}
.form-control {
  width: 100%;
  min-height: 85rpx;
  border: 1rpx solid var(--line, #dfe6df);
  border-radius: var(--radius-control, 19rpx);
  background: var(--surface, #fffefc);
  color: var(--ink, #13251a);
  padding: 19rpx 23rpx;
  font-size: 27rpx;
  box-sizing: border-box;
}
.form-placeholder { color: var(--text-3, #68746c); }

/* 日期选择器外观：模拟原生 input[type=date] 的右对齐箭头 */
.picker-face {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.picker-value { font-size: 27rpx; color: var(--ink, #13251a); }
.picker-arrow { color: var(--text-3, #68746c); font-size: 23rpx; }

.textarea-face {
  min-height: 152rpx;
  line-height: 1.55;
  width: 100%;
  box-sizing: border-box;
}

/* 内联按钮组（原型 .inline-actions：1fr 1.45fr） */
.inline-actions {
  display: grid;
  grid-template-columns: 1fr 1.45fr;
  gap: 17rpx;
  margin-top: 32rpx;
}

/* 日期区间（原型 .export-range：1fr auto 1fr） */
.export-range {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: end;
  gap: 15rpx;
}
.export-range .form-group { margin-bottom: 0; }
.range-sep {
  padding-bottom: 25rpx;
  color: var(--text-3, #68746c);
  font-size: 23rpx;
  line-height: 1.4;
}

/* 模板信息（原型 .ai-state） */
.ai-state {
  margin-top: 34rpx;
  padding: 25rpx 27rpx;
  border-radius: var(--radius-control, 19rpx);
  background: var(--linen, #e1f4df);
  color: var(--forest, #0f3e17);
  font-size: 23rpx;
  line-height: 1.5;
}

/* 留样规范列表（原型 .policy-list / .policy） */
.policy-list { border-top: 1rpx solid var(--line, #dfe6df); }
.policy {
  padding: 29rpx 0;
  border-bottom: 1rpx solid var(--line, #dfe6df);
  display: grid;
  grid-template-columns: 156rpx 1fr;
  gap: 23rpx;
  align-items: start;
}
.policy-key {
  color: var(--forest, #0f3e17);
  font-size: 23rpx;
  font-weight: 650;
}
.policy-desc {
  color: var(--text-2, #526158);
  font-size: 23rpx;
  line-height: 1.6;
}
