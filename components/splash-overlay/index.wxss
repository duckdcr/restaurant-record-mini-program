.splash-overlay {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--canvas, #f7f8f3);
  opacity: 1;
  transition: opacity 260ms ease-out;
}
.splash-overlay.leaving { opacity: 0; }
.splash-image {
  width: 86vw;
  height: 86vw;
  max-width: 640rpx;
  max-height: 640rpx;
  animation: splash-in 1800ms cubic-bezier(.2, 0, 0, 1) both;
}
@keyframes splash-in {
  0% { opacity: 0; transform: scale(.94); }
  18% { opacity: 1; }
  100% { opacity: 1; transform: scale(1); }
}
